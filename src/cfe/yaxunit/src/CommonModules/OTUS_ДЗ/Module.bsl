#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
ЮТТесты.ВТранзакции()
    .ДобавитьТестовыйНабор("Документы Приход и Расход товара")
    .ДобавитьСерверныйТест("ПроверитьСозданиеДокументовПриходТовара")
    .ДобавитьСерверныйТест("ПроверитьСозданиеДокументовРасходТовара")
    .ДобавитьСерверныйТест("ПроверитьПроведениеДокументовПриходТовара")
    .ДобавитьСерверныйТест("ПроверитьПроведениеДокументовРасходТовара")
    .ДобавитьСерверныйТест("ПроверитьНулевыеОстаткиРегистров");
	
КонецПроцедуры

Процедура ПроверитьСозданиеДокументовПриходТовара() Экспорт
	
	ДанныеТеста = ПодготовитьДанныеДляТестаПриходТовара();
	
	ЮТест.ОжидаетЧто(ДанныеТеста.СписокДокументов, "Массив документов ПриходТовара")
	.ИмеетДлину(4);
	
	Для Индекс = 0 По ДанныеТеста.СписокДокументов.ВГраница() Цикл
		Ссылка = ДанныеТеста.СписокДокументов[Индекс];
		ЮТест.ОжидаетЧто(Ссылка, "Документ ПриходТовара #" + (Индекс + 1) + " создан")
		.Заполнено()
		.Свойство("Проведен").Равно(Истина);
	КонецЦикла;
	
КонецПроцедуры

