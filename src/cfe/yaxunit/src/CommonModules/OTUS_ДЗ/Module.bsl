Процедура ПроверитьНулевыеОстаткиРегистров() Экспорт
	
	ДанныеТеста = ПодготовитьДанныеПриходИРасходНулевыеОстатки();
	
	ЗапросТовары = Новый Запрос(
	"ВЫБРАТЬ
	|   ТоварныеЗапасыОстатки.Товар.Наименование КАК Товар,
	|   ЕСТЬNULL(ТоварныеЗапасыОстатки.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|   РегистрНакопления.ТоварныеЗапасы.Остатки(
	|       ,
	|       Товар В (&Товары) И Склад = &Склад
	|   ) КАК ТоварныеЗапасыОстатки
	|ГДЕ
	|   ЕСТЬNULL(ТоварныеЗапасыОстатки.КоличествоОстаток, 0) <> 0"
	);
	ЗапросТовары.УстановитьПараметр("Товары", ДанныеТеста.Товары);
	ЗапросТовары.УстановитьПараметр("Склад", ДанныеТеста.Склад);
	ОстаткиТоваров = ЗапросТовары.Выполнить().Выгрузить();
	
	ЮТест.ОжидаетЧто(ОстаткиТоваров).ИмеетДлину(0);
	
	ЗапросВзаиморасчеты = Новый Запрос(
	"ВЫБРАТЬ
	|   ВзаиморасчетыОстатки.Контрагент.Наименование КАК Контрагент,
	|   ЕСТЬNULL(ВзаиморасчетыОстатки.СуммаОстаток, 0) КАК Остаток
	|ИЗ
	|   РегистрНакопления.Взаиморасчеты.Остатки(
	|       ,
	|       Контрагент = &Контрагент
	|   ) КАК ВзаиморасчетыОстатки
	|ГДЕ
	|   ЕСТЬNULL(ВзаиморасчетыОстатки.СуммаОстаток, 0) <> 0"
	);
	ЗапросВзаиморасчеты.УстановитьПараметр("Контрагент", ДанныеТеста.Контрагент);
	ОстаткиВзаиморасчетов = ЗапросВзаиморасчеты.Выполнить().Выгрузить();
	
	ЮТест.ОжидаетЧто(ОстаткиВзаиморасчетов).ИмеетДлину(0);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьДанныеДляТестаПриходТовара()
	
	Склад = ЮТест.Данные().СоздатьЭлемент("Справочники.Склады");
	Контрагент = ЮТест.Данные().СоздатьЭлемент("Справочники.Контрагенты");
	Организация = ЮТест.Данные().СоздатьЭлемент("Справочники.Организации");
	Валюта = ЮТест.Данные().СоздатьЭлемент("Справочники.Валюты");
	
	Товары = Новый Массив;
	Для Индекс = 1 По 4 Цикл
		Товар = ЮТест.Данные().КонструкторОбъекта("Справочники.Товары")
		.Установить("Вид", Перечисления.ВидыТоваров.Товар)
		.Записать();
		Товары.Добавить(Товар);
	КонецЦикла;
	
	ДатаПрихода = Дата(2026, 1, 1);
	
	СписокДокументов = Новый Массив;
	Для Индекс = 1 По 4 Цикл
		Док = Документы.ПриходТовара.СоздатьДокумент();
		Док.Дата = ДатаПрихода + Индекс;
		Док.Организация = Организация;
		Док.Поставщик = Контрагент;
		Док.Склад = Склад;
		Док.Валюта = Валюта;
		
		Для НомерТовара = 1 По 4 Цикл
			Строка = Док.Товары.Добавить();
			Строка.Товар = Товары[НомерТовара - 1];
			Строка.Количество = 10;
			Строка.Цена = 100 * НомерТовара;
			Строка.Сумма = Строка.Количество * Строка.Цена;
		КонецЦикла;
		
		Док.Записать(РежимЗаписиДокумента.Проведение);
		СписокДокументов.Добавить(Док.Ссылка);
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("Склад", Склад);
	Данные.Вставить("Контрагент", Контрагент);
	Данные.Вставить("Организация", Организация);
	Данные.Вставить("Товары", Товары);
	Данные.Вставить("СписокДокументов", СписокДокументов);
	
	Возврат Данные;
	
КонецФункции

